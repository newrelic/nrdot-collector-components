{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["on tuesday"],
  "automerge": false,
  "dependencyDashboard": false,
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": ["gomodTidy"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": ["renovatebot", "dependencies"],
  "prConcurrentLimit": 200,
  "suppressNotifications": ["prEditedNotification"],
  "packageRules": [
    {
      "description": "Single group for all Dockerfile updates",
      "matchManagers": ["dockerfile"],
      "groupName": "dockerfile deps"
    },
    {
      "description": "Single group for all GitHub Actions updates, pinned by digest",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "groupName": "github actions"
    },
    {
      "description": "Disable Go update types we do not want Renovate to manage",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"
      ],
      "enabled": false
    },
    {
      "description": "OpenTelemetry collector core and contrib modules are managed by the update-otel workflow",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "go.opentelemetry.io/collector{/,}**",
        "github.com/open-telemetry/opentelemetry-collector-contrib{/,}**"
      ],
      "enabled": false
    },
    {
      "description": "Single group for all major Go updates, so they land in one PR",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "groupName": "All go major updates",
      "labels": ["dependency-major-update"]
    },
    {
      "description": "Single group for all non-major Go updates, so they land in one PR",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "All other go packages"
    }
  ]
}
